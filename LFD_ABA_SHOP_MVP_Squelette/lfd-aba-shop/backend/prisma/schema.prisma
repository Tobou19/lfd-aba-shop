generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DIRECTION
  GESTIONNAIRE
  CAISSIER
}

enum Devise {
  FCFA
  NGN
}

enum StatutPaiement {
  PAYE
  EN_ATTENTE
  ANNULE
}

enum ModePaiement {
  MTN_MOMO
  ORANGE_MONEY
  ESPECES
  CARTE
  VIREMENT
}

enum StatutEnvoi {
  NON_ENVOYE
  EMAIL
  WHATSAPP
  LES_DEUX
}

model Utilisateur {
  id                String    @id @default(uuid())
  nomComplet         String
  email              String?   @unique
  telephone          String?   @unique
  motDePasseHash     String
  role               Role
  statut             Boolean   @default(true)
  tentativesEchouees Int       @default(0)
  bloqueJusqua       DateTime?
  derniereConnexion  DateTime?
  centres            UtilisateurCentre[]
  commandesCreees    Commande[]        @relation("AgentCreateur")
  recusEmis          Recu[]            @relation("Caissier")
  journalConnexions  JournalConnexion[]
  journalActions     JournalAction[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Centre {
  id           String    @id @default(uuid())
  nom          String
  adresse      String
  pays         String
  devise       Devise
  responsable  String?
  actif        Boolean   @default(true)
  utilisateurs UtilisateurCentre[]
  produits     Produit[]
  clients      Client[]
  commandes    Commande[]
  createdAt    DateTime  @default(now())
}

model UtilisateurCentre {
  utilisateurId String
  centreId      String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  centre        Centre      @relation(fields: [centreId], references: [id])
  @@id([utilisateurId, centreId])
}

enum TypeProduit {
  NOURRITURE
  STANDARD
}

model Produit {
  id              String      @id @default(uuid())
  nom             String
  nomScientifique String?
  vertus          String?
  prixUnitaire    Decimal     @db.Decimal(10, 2)
  devise          Devise
  // Distingue les repas thérapeutiques (commande par période avec
  // fidélité, §4.5-4.6) des autres produits de la boutique ABA SHOP
  // (commande simple, comme n'importe quel e-commerce classique).
  // Une commande ne peut contenir que des produits d'un seul type
  // (voir OrdersService.create) — le type de la commande en découle.
  type            TypeProduit @default(NOURRITURE)
  centreId        String?
  centre          Centre?     @relation(fields: [centreId], references: [id])
  photoUrl        String?
  disponible      Boolean     @default(true)
  lignesCommande  LigneCommande[]
  createdAt       DateTime    @default(now())
}

model Client {
  id                    String   @id @default(uuid())
  nomComplet            String
  telephone             String
  email                 String?
  centreHabituelId      String
  centreHabituel        Centre   @relation(fields: [centreHabituelId], references: [id])
  photoProfilUrl        String?
  commandes             Commande[]
  recus                 Recu[]
  suiviFidelite         SuiviFidelite[]
  createdAt             DateTime @default(now())
}

enum TypeCommande {
  // Repas thérapeutiques : paiement sur une période (jour, semaine, mois,
  // année), avec suivi de progression et éligibilité à la fidélité
  // (semaine gratuite après 8 semaines consécutives, §4.5-4.6).
  PERIODE
  // Tous les autres produits de la boutique ABA SHOP : commande simple,
  // livrée une fois, comme n'importe quel achat classique — pas de
  // notion de période, pas de fidélité.
  STANDARD
}

model Commande {
  id                String         @id @default(uuid())
  clientId          String
  client            Client         @relation(fields: [clientId], references: [id])
  centreId          String
  centre            Centre         @relation(fields: [centreId], references: [id])
  lieuLivraison     String
  typeCommande      TypeCommande
  // Non nulles uniquement pour une commande de type PERIODE — une
  // commande STANDARD n'a pas de période de service (voir §12 : le
  // classeur Excel ne gérait déjà que les repas de cette façon).
  dateDebut         DateTime?
  dateFin           DateTime?
  sousTraitement    Boolean        @default(false)
  // Pertinents uniquement pour PERIODE (progression jour par jour) ;
  // pour STANDARD, entierementServi bascule directement à la livraison,
  // sans passer par joursServis.
  joursServis       Int            @default(0)
  entierementServi  Boolean        @default(false)
  statutPaiement    StatutPaiement @default(EN_ATTENTE)
  modePaiement      ModePaiement
  montantTotal      Decimal        @db.Decimal(10, 2)
  agentCreateurId   String
  agentCreateur     Utilisateur    @relation("AgentCreateur", fields: [agentCreateurId], references: [id])
  lignes            LigneCommande[]
  recus             RecuCommande[]
  tentativesPaiement TentativePaiementMobile[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model LigneCommande {
  id          String   @id @default(uuid())
  commandeId  String
  commande    Commande @relation(fields: [commandeId], references: [id])
  produitId   String
  produit     Produit  @relation(fields: [produitId], references: [id])
  // Pour une commande PERIODE : quantité consommée par jour (le total
  // servi = quantite × nombre de jours). Pour une commande STANDARD :
  // quantité totale achetée, en une seule fois.
  quantite    Decimal  @db.Decimal(6, 2)
}

// Alimenté uniquement par les commandes de type PERIODE (repas
// thérapeutiques) — les commandes STANDARD (autres produits de la
// boutique) n'entrent jamais dans ce calcul. Voir LoyaltyService.
model SuiviFidelite {
  id                  String    @id @default(uuid())
  clientId            String
  client              Client    @relation(fields: [clientId], references: [id])
  semaineIso          String
  aConsomme           Boolean   @default(false)
  semainesConsecutives Int      @default(0)
  semaineGratuiteDue  Boolean   @default(false)
  dateAttribution     DateTime?
  agentAttributionId  String?

  @@unique([clientId, semaineIso])
}

model Recu {
  id              String        @id @default(uuid())
  numero          String        @unique
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  montantTotal    Decimal       @db.Decimal(10, 2)
  modePaiement    ModePaiement
  caissierId      String
  caissier        Utilisateur   @relation("Caissier", fields: [caissierId], references: [id])
  signatureUrl    String?
  cachetUrl       String?
  photosRepasUrls String[]
  statutEnvoi     StatutEnvoi   @default(NON_ENVOYE)
  fichierPdfUrl   String?
  fichierPngUrl   String?
  commandes       RecuCommande[]
  createdAt       DateTime      @default(now())
}

model RecuCommande {
  recuId     String
  commandeId String
  recu       Recu     @relation(fields: [recuId], references: [id])
  commande   Commande @relation(fields: [commandeId], references: [id])
  @@id([recuId, commandeId])
}

model JournalConnexion {
  id            String      @id @default(uuid())
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  horodatage    DateTime    @default(now())
  adresseIp     String?
  resultat      String
}

model JournalAction {
  id              String      @id @default(uuid())
  utilisateurId   String
  utilisateur     Utilisateur @relation(fields: [utilisateurId], references: [id])
  typeAction      String
  entiteConcernee String
  horodatage      DateTime    @default(now())
}

enum TypeNotification {
  SEMAINE_GRATUITE_DUE
  RUPTURE_STOCK
  RAPPORT_HEBDOMADAIRE
}

model Notification {
  id          String            @id @default(uuid())
  type        TypeNotification
  centreId    String?
  message     String
  lienEntite  String?
  lue         Boolean           @default(false)
  createdAt   DateTime          @default(now())
}

enum StatutTentativePaiement {
  EN_ATTENTE
  REUSSI
  ECHEC
}

// Trace chaque tentative d'encaissement mobile money initiée depuis
// l'application (lot V2, §11) : nécessaire pour rapprocher, de façon
// idempotente, la confirmation reçue en webhook avec la commande
// d'origine, indépendamment de l'ordre d'arrivée des événements réseau.
model TentativePaiementMobile {
  id               String                  @id @default(uuid())
  commandeId       String
  commande         Commande                @relation(fields: [commandeId], references: [id])
  operateur        ModePaiement
  referenceExterne String                  @unique
  telephonePayeur  String
  statut           StatutTentativePaiement @default(EN_ATTENTE)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
}
