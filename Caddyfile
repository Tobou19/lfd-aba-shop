# Reverse proxy avec HTTPS automatique et gratuit (Let's Encrypt), sans
# configuration manuelle de certificat. Remplacer le domaine ci-dessous
# par le vôtre — un sous-domaine DuckDNS gratuit fonctionne aussi bien
# qu'un domaine payant (voir FREE_DEPLOYMENT.md).
{$DOMAINE:app.lfd-services.duckdns.org} {

	# L'API backend reste accessible sous /api/v1 — le frontend appelle
	# cette même origine, pas d'URL séparée à gérer côté client.
	handle /api/* {
		reverse_proxy backend:3000
	}

	# Fichiers générés (reçus PDF/PNG, exports) servis directement par
	# Caddy depuis le volume partagé avec le backend — voir
	# STORAGE_PUBLIC_BASE_URL dans backend/.env.example.
	handle /files/* {
		root * /srv/storage
		file_server
	}

	handle {
		reverse_proxy frontend:80
	}

	encode gzip

	header {
		# L'application ne doit jamais apparaître dans un moteur de
		# recherche public (voir SECURITY.md, point 4).
		X-Robots-Tag "noindex, nofollow"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Strict-Transport-Security "max-age=31536000"
	}
}
