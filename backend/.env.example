DATABASE_URL="postgresql://lfd_user:changeme@localhost:5432/lfd_aba_shop"
JWT_ACCESS_SECRET="change-me-access-32-chars-minimum"
JWT_REFRESH_SECRET="change-me-refresh-32-chars-minimum"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
CORS_ORIGIN="https://app.lfd-services.example"
NODE_ENV="production"

# Génération PDF/PNG (reçus, rapports) via Puppeteer. En développement
# local sans Docker, ne rien renseigner ici : Puppeteer télécharge et
# utilise son propre Chromium automatiquement au moment du `npm install`.
# En conteneur Docker (voir backend/Dockerfile), ces deux variables sont
# déjà définies dans l'image : Chromium système est utilisé à la place,
# aucune action requise de votre part.
# PUPPETEER_SKIP_DOWNLOAD="true"
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium"

# Stockage des fichiers générés (reçus, rapports) — voir Document de
# Conception Technique §7.1. 'local' pour démarrer simplement, 's3' pour
# un stockage compatible S3 en production.
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="./storage"
STORAGE_PUBLIC_BASE_URL="/files"
# S3_BUCKET=""
# S3_REGION=""
# S3_ENDPOINT=""
# S3_PUBLIC_BASE_URL=""

# Paiement mobile money (lot V2, §11) — identifiants fournis par chaque
# opérateur, distincts par environnement (sandbox / production).
MTN_MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
MTN_MOMO_TARGET_ENVIRONMENT="sandbox"

ORANGE_MONEY_BASE_URL="https://api.orange.com"
ORANGE_MONEY_CLIENT_ID=""
ORANGE_MONEY_CLIENT_SECRET=""
ORANGE_MONEY_MERCHANT_KEY=""
ORANGE_MONEY_COUNTRY="cm"
ORANGE_MONEY_RETURN_URL=""
ORANGE_MONEY_CANCEL_URL=""
ORANGE_MONEY_NOTIF_URL=""

# Secret partagé vérifié sur /payments/mobile-money/webhook — à
# configurer côté opérateur ou passerelle d'intégration, jamais laissé
# vide en production.
MOBILE_MONEY_WEBHOOK_SECRET=""
