# Variables pour docker-compose.prod.yml — copier en .env.prod, remplir,
# et lancer avec :
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# Ne jamais committer le fichier .env.prod rempli (déjà exclu par .gitignore).

# Remplacer par votre sous-domaine DuckDNS gratuit (ou domaine payant si
# vous en avez déjà un) — voir FREE_DEPLOYMENT.md, point 2.
DOMAINE=app.lfd-services.duckdns.org

POSTGRES_USER=lfd_user
POSTGRES_PASSWORD=change-moi-en-production
POSTGRES_DB=lfd_aba_shop
DATABASE_URL=postgresql://lfd_user:change-moi-en-production@postgres:5432/lfd_aba_shop

JWT_ACCESS_SECRET=change-moi-32-caracteres-minimum
JWT_REFRESH_SECRET=change-moi-aussi-32-caracteres-minimum

# Secret partagé vérifié sur /payments/mobile-money/webhook — laisser
# vide tant que l'automatisation mobile money n'est pas activée
# (voir FREE_DEPLOYMENT.md, point 5 : l'encaissement manuel ne l'utilise pas).
MOBILE_MONEY_WEBHOOK_SECRET=
